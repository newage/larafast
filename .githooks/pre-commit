#!/usr/bin/env bash
# Запускає тести перед кожним комітом. Пропустити: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

if command -v php >/dev/null 2>&1; then
    php artisan test
else
    docker compose --env-file .env -f docker/docker-compose.yml exec -T php php artisan test
fi
